# === Backend ===
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
PASSWORD_PEPPER=
DATABASE_URL=sqlite:///./puf_mfa.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/puf_mfa
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost,https://127.0.0.1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=sv_access_token
REFRESH_COOKIE_NAME=sv_refresh_token
JWT_REFRESH_ROTATE_DAYS=14
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_SESSION=3

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === WhatsApp OTP (Twilio) ===
# Create at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# User numbers must be whatsapp:+91XXXXXXXXXX format internally

# Alternative: Meta WhatsApp Cloud API
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

OTP_EXPIRE_MINUTES=5

# === PUF Bridge ===
PUF_BRIDGE_MODE=virtual
# virtual | hardware
VIRTUAL_PUF_HOST=127.0.0.1
VIRTUAL_PUF_PORT=8765
HARDWARE_PUF_SERIAL_PORT=COM3
HARDWARE_PUF_BAUD=115200
PUF_HAMMING_THRESHOLD=5

# === Frontend ===
# Development:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/auth
# Production behind TLS reverse proxy:
# NEXT_PUBLIC_API_URL=https://your-domain.com
# NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws/auth

# === Admin ===
ADMIN_EMAIL=admin@pufbank.dev
ADMIN_PASSWORD=change-admin-password
