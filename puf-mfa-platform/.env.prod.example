# Public domain for HTTPS (required by Caddy).
DOMAIN=your-domain.example

# Postgres
POSTGRES_USER=pufmfa
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=puf_mfa
DATABASE_URL=postgresql://pufmfa:change-me-strong-password@db:5432/puf_mfa

# Backend security
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-string
PASSWORD_PEPPER=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=sv_access_token
REFRESH_COOKIE_NAME=sv_refresh_token
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_ROTATE_DAYS=14
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Must include your domain, comma separated if multiple.
CORS_ORIGINS=https://your-domain.example

# OTP
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_SESSION=3
OTP_EXPIRE_MINUTES=5

# Email OTP via Gmail SMTP (required for real OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
OTP_EMAIL_FROM=
OTP_EMAIL_FROM_NAME=SecureVault

# Twilio WhatsApp (optional / unused while email-only)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# PUF
PUF_BRIDGE_MODE=virtual
VIRTUAL_PUF_HOST=puf-bridge
VIRTUAL_PUF_PORT=8765
PUF_HAMMING_THRESHOLD=5
PUF_DEVICE_ID=virtual-cmod-a7-001

# Frontend public URLs
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=wss://your-domain.example/ws/auth

# Admin
ADMIN_EMAIL=admin@pufbank.dev
ADMIN_PASSWORD=admin
